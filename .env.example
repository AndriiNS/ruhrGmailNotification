# Copy to .env.local (Git-ignored). VITE_ variables are PUBLIC: never put secret keys here.
# Only matters WITHOUT Supabase keys (offline UI development with mock data).
# With Supabase keys, regular users always see real data; an admin can switch demo tools on in the header.
VITE_DEMO_MODE=true
# With both Supabase values set, sign-in and sign-up use real Supabase Auth instead of the demo mock.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Backend (server/) address, used by later stages
VITE_API_URL=http://localhost:3001
